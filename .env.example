# Local-only UI. If changed, the container and published ports change together.
SYMPORT_HTTP_PORT=8765
# Optional emulator: tools/install.sh --emulator (Linux amd64, user-owned firmware)
# Optional Gammu config must be mounted explicitly; USB is local to the connected PC.
SYMPORT_GAMMU_CONFIG=
# Optional exact-phone/connection SMS validation profile; configure on the PC Bridge.
# SYMPORT_VERIFIED_SMS_PROFILE=/absolute/private/verified-sms.json
SYMPORT_DEVICE_ROOTS={}
# PC Bridge uses an authenticated loopback SSH tunnel in the Workbench network namespace.
SYMPORT_BRIDGE_URL=
SYMPORT_BRIDGE_KEY=
# Optional compose.phone.yaml: explicit mounted phone/card directory (never /).
# SYMPORT_PHONE_DIRECTORY=/media/your-user/PHONE
# Optional compose.bridge.yaml: SSH tunnel shares the Workbench loopback namespace.
# SYMPORT_SSH_TARGET=your-user@windows-private-address
# SYMPORT_SSH_KEY_FILE=/absolute/path/outside/repo/id_ed25519
# SYMPORT_SSH_KNOWN_HOSTS=/absolute/path/outside/repo/known_hosts
# SYMPORT_SSH_UID=1000
# SYMPORT_SSH_GID=1000
# Browser pairing/outbound Bridge does not need SYMPORT_BRIDGE_URL or KEY.
# Optional authenticated HTTPS proxy: exact browser origin; keep Docker port local.
SYMPORT_PUBLIC_ORIGIN=
# Extra connection JSON must be mounted read-only; paths refer to container paths.
SYMPORT_CONNECTIONS_FILE=
# Only the legacy SSH route: packaged Windows Bridge uses 24652, old Linux helper 8765.
SYMPORT_BRIDGE_AGENT_PORT=8765
